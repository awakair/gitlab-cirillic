{
  "name": "gitlab-cirillic",
  "version": "1.1.0",
  "private": true,
  "description": "Restore legacy-encoded text in GitLab files and merge request diffs.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24.15.0"
  },
  "scripts": {
    "build": "node scripts/build.js",
    "test": "node --test test/*.test.js",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "npm run build && node scripts/lint.js",
    "check": "npm run format:check && npm test && npm run lint",
    "package": "npm run check && python3 scripts/package.py"
  },
  "dependencies": {
    "jschardet": "3.1.4"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "jsdom": "31.0.1",
    "prettier": "3.10.1",
    "web-ext": "10.8.0"
  }
}
